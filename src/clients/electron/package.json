{
  "name": "@boxteam/electron",
  "productName": "BoxTeam",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "main/main.mjs",
  "scripts": {
    "start": "electron ../../../out/packaging/electron/app",
    "install:runtime": "node node_modules/electron/install.js",
    "build": "bun ../../../packaging/electron/build.mjs --project-root ../../..",
    "typecheck": "bun ../workbench/node_modules/@typescript/native-preview/bin/tsgo --project tsconfig.jsonc --noEmit",
    "postinstall": "bun run install:runtime"
  },
  "devDependencies": {
    "electron": "45.1.0"
  }
}
