{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "strict": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["trusted-types", "@webgpu/types", "vscode-notebook-renderer", "wicg-file-system-access"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "upstream/src/typings/*.d.ts", "upstream/src/vscode-dts/*.d.ts", "upstream/src/vs/monaco.d.ts", "upstream/src/vs/workbench/contrib/debug/common/debugProtocol.d.ts"]
}
