{
  // BoxTeam Gateway 控制面配置模式定义。
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxteam.dev/schemas/gateway-config-v4.json",
  "x-boxteam-config-domain": "gateway",
  "x-boxteam-policy-manifest": [
    { "pattern": "/resources", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/resources/skill_sources", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/resources/skill_sources/local_updates", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/resources/skill_sources/local_updates/**", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/resources/skill_sources/sources", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/resources/skill_sources/sources/**", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/logging/runtime/**", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/ui/**", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/permissions", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/permissions/federation", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/permissions/federation/**", "policy": "immediate_read", "activation_scope": "current", "identity_key": null },
    { "pattern": "/features/session_catalog/**", "policy": "next_job", "activation_scope": "next_job", "identity_key": null },
    { "pattern": "/runtime/gateway/process/**", "policy": "restart_gateway", "activation_scope": "restart_gateway", "identity_key": null },
    { "pattern": "/workspaces", "policy": "restart_gateway", "activation_scope": "restart_gateway", "identity_key": null },
    { "pattern": "/workspaces/**", "policy": "restart_gateway", "activation_scope": "restart_gateway", "identity_key": "connection_id" }
  ],
  "title": "BoxTeam Gateway Config Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "workspaces",
    "logging"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "enum": [1, 2, 3, 4],
      "description": "v1 允许缺少 connection_id，v2 持久化连接身份；显式 migrate-runtime-logging 推进到 v4，移除迁至工作区的生成器轮询设置。Gateway workspaces 变化属于 restart_gateway。"
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "pretty"],
          "properties": {
            "level": { "type": "string", "enum": ["debug", "info", "warning", "error", "critical"], "default": "info" },
            "pretty": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_sources"],
      "properties": {
        "skill_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_updates"],
          "properties": {
            "sources": {
              "type": "array", "default": [],
              "description": "Gateway 统一获取的共享网络 Skill；获取地址保持私有，不因代理获取改变 network 层归属。id 唯一且稳定；同层 priority 越大越优先，同名同优先级报冲突。",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "name", "fetch"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
                  "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
                  "priority": {"type": "integer", "default": 0},
                  "fetch": {
                    "type": "object", "additionalProperties": false, "required": ["protocol", "url"],
                    "properties": {
                      "protocol": {"const": "http"},
                      "url": {"type": "string", "pattern": "^https?://[^/]+", "description": "仅 owner 用于获取；禁止 fragment，最终 typed 校验绝对 HTTP(S) 地址。"},
                      "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 30}
                    }
                  },
                  "updates": {
                    "type": "object", "additionalProperties": false, "required": ["mode"],
                    "description": "缺省为每1小时 poll；HTTP 获取尚未登记事件协议，event/event_poll 明确拒绝。",
                    "properties": {"mode": {"enum": ["poll", "manual"]}, "poll_interval": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*(m|h)$"}},
                    "if": {"properties": {"mode": {"const": "poll"}}},
                    "then": {"required": ["poll_interval"], "properties": {"poll_interval": {"type": "string"}}},
                    "else": {"properties": {"poll_interval": {"type": "null"}}}
                  }
                }
              }
            },
            "local_updates": {
              "type": "object",
              "description": "Gateway 本机 Skill 观察策略；经原配置候选 prepare/apply/health/promotion/rollback 热切换，旧订阅在结算后排空。",
              "additionalProperties": false,
              "required": ["mode", "poll_interval"],
              "properties": {
                "mode": {"enum": ["event", "poll", "manual", "event_poll"]},
                "poll_interval": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*(m|h)$"}
              },
              "if": {"properties": {"mode": {"enum": ["poll", "event_poll"]}}},
              "then": {"properties": {"poll_interval": {"type": "string"}}},
              "else": {"properties": {"poll_interval": {"type": "null"}}}
            }
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "description": "Gateway 启动时通过 SSH 连接的远程 Gateway。元素增删改和连接身份变化属于 restart_gateway；v2 使用持久 connection_id。",
      "items": {
        "$ref": "#/$defs/remoteGateway"
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "$ref": "#/$defs/themeConfig"
        }
      }
    },
    "features": {
      "$ref": "#/$defs/featuresConfig"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "federation": {
          "type": "object",
          "additionalProperties": false,
          "description": "权限按当前 snapshot 原子热发布；已建立 channel 保持连接。",
          "properties": {
            "default_effect": { "enum": ["allow", "deny"], "default": "allow" },
            "hardening_enabled": { "type": "boolean", "default": false },
            "rules": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["capability"],
                "properties": {
                  "capability": { "enum": ["discovery", "send", "read", "wait", "reply", "transit", "fork_source", "fork_target", "file_write", "managed_workspace_admin"] },
                  "effect": { "enum": ["allow", "deny"], "default": "deny" },
                  "origin_gateway_id": { "type": ["string", "null"], "minLength": 1 },
                  "principal_ref": { "type": ["string", "null"], "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtimeConfig"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config_version": { "enum": [2, 3] }
        }
      },
      "then": {
        "properties": {
          "workspaces": {
            "items": {
              "required": ["connection_id"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "featuresConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sync": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "refresh_interval_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 30 },
                "max_concurrency": { "type": "integer", "minimum": 1, "default": 8 },
                "request_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 30 }
              }
            }
          }
        },
        "session_history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loading": {
              "$ref": "#/$defs/sessionHistoryLoadingConfig"
            }
          }
        }
      }
    },

    "sessionHistoryLoadingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "progressive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initial": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "turns": { "type": "integer", "minimum": 1, "maximum": 8, "default": 5 },
                "include": { "$ref": "#/$defs/historyInclude" }
              }
            },
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "before_turns": { "type": "integer", "minimum": 1, "maximum": 256, "default": 3 },
                "after_turns": { "type": "integer", "minimum": 1, "maximum": 256, "default": 3 },
                "include": { "$ref": "#/$defs/historyInclude" }
              }
            }
          }
        }
      }
    },
    "historyInclude": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "user",
          "assistant_text",
          "assistant",
          "tool_summary",
          "tool_call",
          "tool_result",
          "thinking",
          "internal",
          "metadata",
          "final_response"
        ]
      }
    },

    "runtimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "process": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "health": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "request_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 2 },
                    "poll_interval_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 }
                  }
                },
                "lifecycle": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "connection_drain_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 2 }
                  }
                }
              }
            }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_skill_groups": {
              "type": "array",
              "description": "启动 Gateway 托管 Workspace 时默认启用的发行包 Skill 组。",
              "uniqueItems": true,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              },
              "default": ["browser-control", "gateway-context", "web-search-fetch", "debugging"]
            }
          }
        }
      }
    },

    "themeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_theme_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "default": "warm" },
        "custom_themes": {
          "type": "array",
          "items": { "$ref": "#/$defs/customTheme" },
          "default": []
        }
      }
    },
    "customTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "extends"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "extends": { "enum": ["warm", "green", "blue"] },
        "color_scheme": { "enum": ["light", "dark"], "default": "light" },
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^--bt-[a-z0-9-]+$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "background": { "$ref": "#/$defs/themeBackground" }
      }
    },
    "themeBackground": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "remote" }, "url": { "type": "string", "minLength": 1 },
            "position": { "type": "string", "default": "center" }, "size": { "type": "string", "default": "cover" },
            "repeat": { "enum": ["no-repeat", "repeat", "repeat-x", "repeat-y", "space", "round"], "default": "no-repeat" },
            "appearance": { "enum": ["immersive", "theme"], "default": "immersive" },
            "overlay": { "type": "string", "default": "linear-gradient(180deg, rgb(17 19 24 / 0.08) 0%, rgb(17 19 24 / 0.16) 54%, rgb(17 19 24 / 0.44) 100%)" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "local_file" }, "path": { "type": "string", "minLength": 1 },
            "position": { "type": "string", "default": "center" }, "size": { "type": "string", "default": "cover" },
            "repeat": { "enum": ["no-repeat", "repeat", "repeat-x", "repeat-y", "space", "round"], "default": "no-repeat" },
            "appearance": { "enum": ["immersive", "theme"], "default": "immersive" },
            "overlay": { "type": "string", "default": "linear-gradient(180deg, rgb(17 19 24 / 0.08) 0%, rgb(17 19 24 / 0.16) 54%, rgb(17 19 24 / 0.44) 100%)" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "asset_id"],
          "properties": {
            "type": { "const": "gateway_asset" }, "asset_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "position": { "type": "string", "default": "center" }, "size": { "type": "string", "default": "cover" },
            "repeat": { "enum": ["no-repeat", "repeat", "repeat-x", "repeat-y", "space", "round"], "default": "no-repeat" },
            "appearance": { "enum": ["immersive", "theme"], "default": "immersive" },
            "overlay": { "type": "string", "default": "linear-gradient(180deg, rgb(17 19 24 / 0.08) 0%, rgb(17 19 24 / 0.16) 54%, rgb(17 19 24 / 0.44) 100%)" }
          }
        }
      ]
    },
    "remoteGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "host",
        "username",
        "private_key_path"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "description": "稳定的远程连接身份；host、username 或 key 变化时保留该 ID 并递增其 registry generation。",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "kind": {
          "const": "remote_gateway"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "private_key_path": {
          "type": "string",
          "minLength": 1
        },
        "ssh_config_host": {
          "type": "string",
          "minLength": 1
        },
        "remote_pair_command": {
          "type": "string",
          "minLength": 1
        },
        "remote_gateway_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8014
        },
        "activate": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
