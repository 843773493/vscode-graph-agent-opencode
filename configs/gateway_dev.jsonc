{
  "$schema": "./gateway_schema.jsonc",
  "config_version": 4,
  "logging": {
    "runtime": {
      "level": "info",
      "pretty": true
    }
  },
  "resources": {
    "skill_sources": {
      "sources": [], // 显式共享来源：稳定 id、name、fetch.protocol=http/url、updates 与层内 priority。数组整体覆盖。
      "local_updates": {
        "mode": "event", // Gateway 本机 Skill 的获取触发；与 Workspace 消费发布通知分别配置。
        "poll_interval": null // poll/event_poll 必须使用正整数分钟 m 或小时 h；对象按配置层递归合并。
      }
    }
  },
  "workspaces": [
    {
      "enabled": true,
      "kind": "remote_gateway",
      "connection_id": "connection_dev_container",
      "name": "Gateway E2E Docker Gateway",
      "host": "127.0.0.1",
      "port": 22222,
      "username": "boxteam",
      "private_key_path": "~/.ssh/boxteam-container",
      "ssh_config_host": "boxteam-container",
      "remote_pair_command": "BOXTEAM_HOME=/home/boxteam/.boxteams-dev BOXTEAM_GATEWAY_ROOT=/home/boxteam/.boxteams-dev/state/gateway boxteam gateway issue-federation-token",
      "remote_gateway_port": 8014,
      "activate": false
    }
  ],
  "runtime": {
    "workspace": {
      "default_skill_groups": [
        "browser-control",
        "gateway-context",
        "web-search-fetch",
        "debugging"
      ]
    }
  }
}
