{
  // BoxTeam Gateway 控制面配置模式定义。
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxteam.dev/schemas/gateway-config-v1.json",
  "title": "BoxTeam Gateway Config Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "workspaces"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "const": 1
    },
    "workspaces": {
      "type": "array",
      "description": "Gateway 启动时通过 SSH 连接的远程 Gateway。",
      "items": {
        "$ref": "#/$defs/remoteGateway"
      }
    }
  },
  "$defs": {
    "remoteGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "host",
        "username",
        "private_key_path"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "kind": {
          "const": "remote_gateway"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "private_key_path": {
          "type": "string",
          "minLength": 1
        },
        "remote_gateway_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8014
        },
        "activate": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
