          },
          "execution": {
            "stream": true,
            "max_turns": 16,
            "max_history_messages": 30,
            "max_context_tokens": 32000,
            "require_delegated_report": false
          }
        },
        "researcher": {
          "name": "Research Assistant",
          "description": "专门用于资料检索、文档总结和方案调研。",
          "language": "zh-CN",
          "timezone": "Asia/Shanghai",
          "tags": [],
          "instructions": {
            "system_prompt_file": null,
            "system_prompt": "你是调研助手。优先基于可验证来源归纳结论，并明确不确定点和假设。",
            "runtime_identity": {
              "description_file": null,
              "description": "普通文件入口支持相对路径、目标机器原生绝对路径和资源 URI；相对路径按显式目标工作区或选定目录解析。`.` 表示工作区根，工具 owner 在目标机器解析真实目录。终端与 shell 保留操作系统原生路径语义。exec_command 的相对 workdir 只解析一次，结果中的 cwd_relative 用于解释其相对路径。配置候选并不等于本次实际调用，不能从工作区文件或项目名称推断模型身份。"
            }
