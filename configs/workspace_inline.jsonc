{
  "$schema": "./workspace_schema.jsonc",
  "config_version": 4,
  "settings": {
    "workspace": {
      "plugins": {
        "runtime": {
          "entries": []
        }
      },
      "llm": {
        "providers": {
          "primary": {
            "models": {
              "default": {
                "model": "big-pickle",
                "config_ref": "context:provider/primary"
              }
            },
            "config_ref": "#/profiles/provider.primary"
          },
          "backup_1": {
            "models": {
              "default": {
                "model": "openrouter/free",
                "config_ref": "context:provider/backup_1"
              }
            },
            "config_ref": "#/profiles/provider.backup_1"
          },
          "backup_2": {
            "models": {
              "default": {
                "model": "openrouter/free",
                "config_ref": "context:provider/backup_2"
              }
            },
            "config_ref": "#/profiles/provider.backup_2"
          },
          "backup_3": {
            "models": {
              "default": {
                "model": "gpt-6-luna",
                "config_ref": "context:provider/backup_3"
              }
            },
            "config_ref": "#/profiles/provider.backup_3"
          },
          "backup_4": {
            "models": {
              "default": {
                "model": "gpt-6-luna",
                "config_ref": "context:provider/backup_4"
              }
            },
            "config_ref": "#/profiles/provider.backup_4"
          },
          "newapi_deepseek": {
            "models": {
              "default": {
                "model": "deepseek-v4.1-flash-1017",
                "config_ref": "context:provider/newapi_deepseek"
              }
            },
            "config_ref": "#/profiles/provider.newapi_deepseek"
          },
          "DeepSeek-V4.1-Flash": {
            "models": {
              "default": {
                "model": "DeepSeek-V4.1-Flash",
                "config_ref": "context:provider/DeepSeek-V4.1-Flash"
              }
            },
            "config_ref": "#/profiles/provider.DeepSeek-V4.1-Flash"
          }
        }
      },
      "resources": {
        "skill_sources": {
          "sources": [],
          "gateway_updates": {
            "mode": "event",
            "poll_interval": null
          }
        }
      },
      "context": {
        "compaction": {
          "prepare_fraction": 0.80,
          "apply_fraction": 0.90,
          "target_fraction": 0.55,
          "apply_policy": "on_demand"
        },
        "source_messages": {
          "grouping": "aggregate"
        },
        "resource_activation": {
          "default_boundary": "turn",
          "overrides": {
            "mcp_tool_catalog": "turn"
          }
        }
      },
      "tooling": {
        "policy_defaults": {
          "execution_enabled": true,
          "model_visible": true,
          "confirmation_required": false,
          "limits": {
            "timeout_ms": 10000,
            "max_result_bytes": 1048576
          }
        },
        "policy_rules": {
          "by_origin": {
            "custom": {
              "model_visible": false
            },
            "mcp": {
              "model_visible": false
            }
          },
          "by_kind": {
            "debugging": {
              "model_visible": false
            }
          },
          "by_group": {},
          "by_tool": {}
        },
        "restrictions": {
          "execution_disabled": [],
          "model_hidden": [],
          "confirmation_required": []
        }
      },
      "default_agent": "default",
      "agents": {
        "default": {
          "name": "Workspace Assistant",
          "description": "工作区默认助手，负责通用问答、代码解释、开发辅助和文档问答。",
          "language": "zh-CN",
          "timezone": "Asia/Shanghai",
          "tags": [],
          "persona": {
            "role": "工程团队工作区助手",
            "tone": "professional",
            "identity": "",
            "verbosity": "medium"
          },
          "instructions": {
            "system_prompt_file": null,
            "system_prompt": "你是面向工程团队的工作区助手。优先提供准确、可执行、可验证的回答；信息不足时明确指出缺失信息。",
            "runtime_identity": {
              "description_file": null,
              "description": "普通文件入口支持相对路径、目标机器原生绝对路径和资源 URI；相对路径按显式目标工作区或选定目录解析。`.` 表示工作区根，工具 owner 在目标机器解析真实目录。终端与 shell 保留操作系统原生路径语义。exec_command 的相对 workdir 只解析一次，结果中的 cwd_relative 用于解释其相对路径。配置候选并不等于本次实际调用，不能从工作区文件或项目名称推断模型身份。"
            }
          },
          "model": {
            "primary": {
              "provider_id": "primary",
              "model_id": "default"
            },
            "fallbacks": [
              {
                "provider_id": "backup_1",
                "model_id": "default"
              },
              {
                "provider_id": "backup_2",
                "model_id": "default"
              },
              {
                "provider_id": "backup_3",
                "model_id": "default"
              },
              {
                "provider_id": "backup_4",
                "model_id": "default"
              },
              {
                "provider_id": "newapi_deepseek",
                "model_id": "default"
              },
              {
                "provider_id": "DeepSeek-V4.1-Flash",
                "model_id": "default"
              }
            ]
          },
          "tools": {
            "tool_choice": "auto",
            "timeout_ms": 10000,
            "allowlist": [],
            "denylist": [],
            "confirmation_required": [],
            "custom": [
              {
                "tool_id": "connections.manage"
              },
              {
                "tool_id": "read_context"
              },
              {
                "tool_id": "search_context"
              },
              {
                "tool_id": "discover_workspaces"
              },
              {
                "tool_id": "search_resources"
              },
              {
                "tool_id": "web_search"
              },
              {
                "tool_id": "fetch_webpage"
              },
              {
                "tool_id": "listBrowserPage"
              },
              {
                "tool_id": "openBrowserPage"
              },
              {
                "tool_id": "readPage"
              },
              {
                "tool_id": "navigatePage"
              },
              {
                "tool_id": "clickElement"
              },
              {
                "tool_id": "typeInPage"
              },
              {
                "tool_id": "hoverElement"
              },
              {
                "tool_id": "dragElement"
              },
              {
                "tool_id": "handleDialog"
              },
              {
                "tool_id": "screenshotPage"
              },
              {
                "tool_id": "runPlaywrightCode"
              },
              {
                "name": "list_debug_configurations",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "list_debug_configurations"
                },
                "description": "列出当前会话的可移植源码调试方案，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "create_debug_configuration",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "create_debug_configuration"
                },
                "description": "创建并激活目标程序调试方案，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "activate_debug_configuration",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "activate_debug_configuration"
                },
                "description": "激活当前会话的目标程序调试方案，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "delete_debug_configuration",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "delete_debug_configuration"
                },
                "description": "删除当前会话未运行的目标程序调试方案，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "start_debugging",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "start_debugging"
                },
                "description": "源码调试扩展工具 start_debugging，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "stop_debugging",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "stop_debugging"
                },
                "description": "源码调试扩展工具 stop_debugging，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "step_over",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "step_over"
                },
                "description": "源码调试扩展工具 step_over，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "step_into",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "step_into"
                },
                "description": "源码调试扩展工具 step_into，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "step_out",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "step_out"
                },
                "description": "源码调试扩展工具 step_out，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "continue_execution",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "continue_execution"
                },
                "description": "源码调试扩展工具 continue_execution，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "pause_execution",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "pause_execution"
                },
                "description": "源码调试扩展工具 pause_execution，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "restart_debugging",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "restart_debugging"
                },
                "description": "源码调试扩展工具 restart_debugging，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "add_breakpoint",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "add_breakpoint"
                },
                "description": "源码调试扩展工具 add_breakpoint，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "add_logpoint",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "add_logpoint"
                },
                "description": "源码调试扩展工具 add_logpoint，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "remove_breakpoint",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "remove_breakpoint"
                },
                "description": "源码调试扩展工具 remove_breakpoint，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "clear_all_breakpoints",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "clear_all_breakpoints"
                },
                "description": "源码调试扩展工具 clear_all_breakpoints，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "list_breakpoints",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "list_breakpoints"
                },
                "description": "源码调试扩展工具 list_breakpoints，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "list_variable_names",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "list_variable_names"
                },
                "description": "源码调试扩展工具 list_variable_names，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "get_variables_values",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "get_variables_values"
                },
                "description": "源码调试扩展工具 get_variables_values，必须通过 invoke_extension_tool 调用。"
              },
              {
                "name": "evaluate_expression",
                "factory": "app.agents.tools.debugging:create_debugging_tool",
                "options": {
                  "tool_name": "evaluate_expression"
                },
                "description": "源码调试扩展工具 evaluate_expression，必须通过 invoke_extension_tool 调用。"
              }
            ]
          },
          "safety": {
            "policy_mode": "standard",
            "prompt_injection_protection": true,
            "pii_redaction": true,
            "refuse_secrets_exfiltration": true
          },
          "execution": {
            "stream": true,
            "max_turns": 16,
            "max_history_messages": 30,
            "max_context_tokens": 32000,
            "require_delegated_report": false
          },
          "env": {
            "mode": "development",
            "region": "",
            "feature_flags": {}
          }
        },
        "coder": {
          "name": "Coding Assistant",
          "description": "专门用于代码实现、重构和修复问题。",
          "language": "zh-CN",
          "timezone": "Asia/Shanghai",
          "tags": [],
          "instructions": {
            "system_prompt_file": null,
            "system_prompt": "你是工程实践导向的编程助手。输出代码时优先保证正确性、可读性和可验证性。",
            "runtime_identity": {
              "description_file": null,
              "description": "普通文件入口支持相对路径、目标机器原生绝对路径和资源 URI；相对路径按显式目标工作区或选定目录解析。`.` 表示工作区根，工具 owner 在目标机器解析真实目录。终端与 shell 保留操作系统原生路径语义。exec_command 的相对 workdir 只解析一次，结果中的 cwd_relative 用于解释其相对路径。配置候选并不等于本次实际调用，不能从工作区文件或项目名称推断模型身份。"
            }
          },
          "model": {
            "primary": {
              "provider_id": "primary",
              "model_id": "default"
            },
            "fallbacks": [
              {
                "provider_id": "backup_1",
                "model_id": "default"
              },
              {
                "provider_id": "backup_2",
                "model_id": "default"
              },
              {
                "provider_id": "backup_3",
                "model_id": "default"
              },
              {
                "provider_id": "backup_4",
                "model_id": "default"
              },
              {
                "provider_id": "newapi_deepseek",
                "model_id": "default"
              },
              {
                "provider_id": "DeepSeek-V4.1-Flash",
                "model_id": "default"
              }
            ]
          },
          "tools": {
            "tool_choice": "auto",
            "timeout_ms": 10000,
            "allowlist": [],
            "denylist": [
              "edit_file"
            ],
            "confirmation_required": [],
            "custom": []
          },
          "execution": {
            "stream": true,
            "max_turns": 16,
            "max_history_messages": 30,
            "max_context_tokens": 32000,
            "require_delegated_report": false
          }
        },
        "reviewer": {
          "name": "Code Reviewer",
          "description": "专门用于代码审查、风险检查和设计评估。",
          "language": "zh-CN",
          "timezone": "Asia/Shanghai",
          "tags": [],
          "instructions": {
            "system_prompt_file": null,
            "system_prompt": "你是代码审查助手。优先指出正确性、架构、安全性和可维护性问题，并给出具体依据。",
            "runtime_identity": {
              "description_file": null,
              "description": "普通文件入口支持相对路径、目标机器原生绝对路径和资源 URI；相对路径按显式目标工作区或选定目录解析。`.` 表示工作区根，工具 owner 在目标机器解析真实目录。终端与 shell 保留操作系统原生路径语义。exec_command 的相对 workdir 只解析一次，结果中的 cwd_relative 用于解释其相对路径。配置候选并不等于本次实际调用，不能从工作区文件或项目名称推断模型身份。"
            }
          },
          "model": {
            "primary": {
              "provider_id": "primary",
              "model_id": "default"
            },
            "fallbacks": [
              {
                "provider_id": "backup_1",
                "model_id": "default"
              },
              {
                "provider_id": "backup_2",
