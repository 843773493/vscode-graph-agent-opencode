{
  "$schema": "./model_stream_schema.jsonc",
  "config_version": 1,
  "model_stream": {
    "transport": {
      "mode": "replay",
      "scenario_id": "child-thread-delegate",
      "matching": {
        "policy": "strict"
      },
      "replay": {
        "policy": "request_reusable"
      },
      "timing": {
        "mode": "none"
      },
      "recording": {
        "artifact_root": "out/tests/e2e/clients/web/test_child_thread_panel/artifacts/model-stream"
      }
    }
  }
}
