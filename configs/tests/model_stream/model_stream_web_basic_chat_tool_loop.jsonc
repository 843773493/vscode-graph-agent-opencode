{
  "$schema": "./model_stream_schema.jsonc",
  "config_version": 1,
  "model_stream": {
    "transport": {
      "mode": "replay",
      "scenario_id": "basic-chat-tool-loop",
      "matching": {
        "policy": "strict"
      },
      "replay": {
        "policy": "request_reusable"
      },
      "timing": {
        "mode": "none"
      },
      "recording": {
        "artifact_root": "out/tests/integration/clients/web/conversation_lifecycle/test_conversation_lifecycle/artifacts/model-stream"
      }
    }
  }
}
