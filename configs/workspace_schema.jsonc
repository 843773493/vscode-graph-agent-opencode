{
  // ============================================================
  // BoxTeam Workspace 配置模式定义 (JSON Schema)
  // ============================================================
  // 此文件定义了 workspace.jsonc 配置文件的验证模式。
  // 用于 JSON Schema 验证，确保配置文件结构正确。
  //
  // 文件位置: configs/workspace_schema.jsonc
  // 参考标准: https://json-schema.org/
  //
  // 配置生效规则:
  // - llm、agents、development 支持热重载；有效配置变化后从下一轮 Job 开始生效，
  //   已经运行中的 Job 会继续使用启动时的配置快照。
  // - default_agent 支持热重载，但只影响后续新建会话；已有会话保持其 agent_id。
  // - ui 配置支持热重载，后续配置读取使用新值。
  // - logger 当前不会动态调整运行中的日志系统，需要重启工作区后端。
  // - mcp 当前不支持进程内热切换；修改会拒绝整个候选配置，需要重启工作区后端。
  // - 用户级配置与工作区级配置深度合并；被高优先级值遮蔽的低优先级变化
  //   不会触发有效配置 revision 变化。
  // ============================================================

  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxteam.dev/schemas/workspace-config-v1.json",
  "title": "BoxTeam Workspace Config Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "llm",
    "logger",
    "default_agent",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "const": 1,
      "description": "配置格式版本；程序会在加载旧版本时按顺序迁移。"
    },
    "llm": {
      "type": "object",
      "description": "LLM Provider 配置。支持热重载，从下一轮 Job 开始生效；运行中的 Job 保持原配置快照。",
      "additionalProperties": false,
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provider"
          }
        }
      }
    },
    "logger": {
      "type": "object",
      "description": "日志配置。修改后需要重启工作区后端。",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "critical"
          ],
          "default": "info"
        },
        "pretty": {
          "type": "boolean",
          "description": "是否使用带 UTC 时间戳的本地易读格式；false 使用不带时间戳的紧凑文本格式。进程日志始终是文本流，不承诺 JSONL。修改后需要重启工作区后端。",
          "default": true
        }
      }
    },
    "default_agent": {
      "type": "string",
      "description": "Default agent key in the agents object. 支持热重载，但只影响后续新建会话；已有会话保持其 agent_id。",
      "pattern": "^[a-zA-Z0-9._-]{2,64}$",
      "default": "default"
    },
    "agents": {
      "type": "object",
      "description": "Workspace agent registry, keyed by agent name. 支持热重载，从下一轮 Job 开始生效；运行中的 Job 保持原配置快照。",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/agentConfig"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9._-]{2,64}$"
      }
    },
    "ui": {
      "$ref": "#/$defs/uiConfig"
    },
    "mcp": {
      "$ref": "#/$defs/mcpConfig"
    },
    "development": {
      "$ref": "#/$defs/developmentConfig"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeConfig"
    }
  },
  "$defs": {
    "runtimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/agentRuntimeConfig" },
        "gateway": { "$ref": "#/$defs/gatewayRuntimeConfig" },
        "auxiliary_services": { "$ref": "#/$defs/auxiliaryServicesConfig" },
        "workspace": { "$ref": "#/$defs/workspaceRuntimeConfig" },
        "events": { "$ref": "#/$defs/eventsRuntimeConfig" },
        "debug": { "$ref": "#/$defs/debugRuntimeConfig" }
      }
    },

    "debugRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否允许 Agent 使用源码调试后端。"
        },
        "default_adapter": {
          "type": "string",
          "enum": ["node_inspector", "debugpy", "dap", "vscode"],
          "default": "node_inspector",
          "description": "未指定 launch profile 时使用的逻辑调试 adapter。"
        },
        "command_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10,
          "description": "单个调试后端命令的超时时间。"
        },
        "node": { "$ref": "#/$defs/nodeDebugRuntimeConfig" },
        "python": { "$ref": "#/$defs/pythonDebugRuntimeConfig" },
        "launch_profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/debugLaunchProfile" },
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]{1,64}$"
          }
        }
      }
    },

    "nodeDebugRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspector_host": {
          "type": "string",
          "minLength": 1,
          "default": "127.0.0.1"
        },
        "inspector_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "executable": {
          "type": "string",
          "default": "",
          "description": "Node 可执行文件；为空时由运行时按既有环境规则解析。"
        }
      }
    },

    "pythonDebugRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "const": "debugpy",
          "default": "debugpy"
        },
        "debugpy_host": {
          "type": "string",
          "minLength": 1,
          "default": "127.0.0.1"
        },
        "debugpy_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        }
      }
    },

    "debugLaunchProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["node_inspector", "debugpy", "dap", "vscode"],
          "default": "node_inspector"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "default": "node"
        },
        "program": {
          "type": "string",
          "default": ""
        },
        "working_directory": {
          "type": "string",
          "default": ""
        },
        "args": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" },
          "default": []
        }
      }
    },

    "agentRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["single_agent", "team"] , "default": "single_agent" },
            "response_mode": { "type": "string", "minLength": 1, "default": "stream" },
            "async": { "type": "boolean", "default": true },
            "max_steps": { "type": "integer", "minimum": 1, "default": 20 },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 600 }
          }
        }
      }
    },

    "gatewayRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri", "minLength": 1, "default": "http://127.0.0.1:8014" },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 30 }
          }
        }
      }
    },

    "auxiliaryServicesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminal_backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri", "minLength": 1, "default": "http://127.0.0.1:8012" }
          }
        },
        "browser_backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri", "minLength": 1, "default": "http://127.0.0.1:8015" }
          }
        }
      }
    },

    "workspaceRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "list": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "default_limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 500 }
              }
            },
            "preview": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_bytes": { "type": "integer", "minimum": 1, "default": 1048576 },
                "binary_sample_bytes": { "type": "integer", "minimum": 1, "default": 8192 }
              }
            }
          }
        }
      }
    },

    "eventsRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_stream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heartbeat_interval_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 15 }
          }
        }
      }
    },

    "uiConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_model": {
          "type": "string",
          "minLength": 1,
          "description": "可选的 UI 展示模型；省略时根据 default_agent.primary_provider 动态解析。"
        },
        "default_orchestration": {
          "type": "string",
          "minLength": 1,
          "default": "single_agent"
        },
        "max_concurrent_agents": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "allow_shell_tools": {
          "type": "boolean",
          "default": false
        },
        "ignored_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "auto_summarize": {
          "type": "boolean",
          "default": true
        }
      }
    },

    "mcpConfig": {
      "type": "object",
      "description": "当前工作区后端连接的 MCP Server。当前不支持进程内热切换；修改会拒绝整个候选配置，需要重启工作区后端。",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mcpServer"
          }
        }
      }
    },

    "mcpServer": {
      "oneOf": [
        {
          "$ref": "#/$defs/mcpStdioServer"
        },
        {
          "$ref": "#/$defs/mcpStreamableHttpServer"
        }
      ]
    },

    "mcpStdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "command"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "transport": {
          "const": "stdio"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "mcpStreamableHttpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "url"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "transport": {
          "const": "streamable_http"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },

    "developmentConfig": {
      "type": "object",
      "description": "仅由开发安装生成器写入的功能开关。支持热重载，从下一轮 Job 开始生效。",
      "additionalProperties": false,
      "properties": {
        "test_tools": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint",
        "model",
        "custom_llm_provider",
        "api_mode"
      ],
      "allOf": [
        {
          "if": {
            "required": ["auth"]
          },
          "then": {
            "properties": {
              "custom_llm_provider": {
                "const": "chatgpt"
              },
              "api_mode": {
                "properties": {
                  "protocol": {
                    "const": "responses"
                  }
                }
              }
            }
          },
          "else": {
            "required": ["api_key"]
          }
        },
        {
          "if": {
            "properties": {
              "api_mode": {
                "properties": {
                  "protocol": {
                    "const": "anthropic_messages"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "custom_llm_provider": {
                "const": "anthropic"
              }
              // 已验证：Anthropic Messages adapter 只在该 provider 适配族下实例化。
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable unique ID of the provider, referenced by agents.*.model",
          "pattern": "^[a-zA-Z0-9._-]{2,64}$",
          "minLength": 2,
          "maxLength": 64
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "api_key": {
          "description": "Can be a literal API key string, or an environment variable reference like ${OPENAI_API_KEY}.",
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "method"],
          "description": "Provider 专属认证。ChatGPT OAuth 凭据由 LiteLLM 在 BOXTEAM_HOME/auth/chatgpt 下独立维护。",
          "properties": {
            "type": {
              "const": "oauth"
            },
            "method": {
              "const": "chatgpt"
            }
          }
        },
        "custom_llm_provider": {
          "type": "string",
          "minLength": 1,
          "description": "LiteLLM custom_llm_provider 参数，例如 openai、openrouter、anthropic。"
        },
        "api_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "model_info",
            "supports_reasoning"
          ],
          "description": "Provider 请求协议、LiteLLM 对齐的模型能力、reasoning 线格式以及请求特性。",
          "properties": {
            "protocol": {
              "type": "string",
              "enum": [
                "chat_completions",
                "responses",
                "anthropic_messages"
              ],
              "description": "选择 LiteLLM 请求协议；custom_llm_provider 只选择适配族，不替代协议。"
              // 已验证：AgentFactory 根据 protocol 分派 Chat Completions、Responses 和 Anthropic Messages。
            },
            "model_info": {
              "type": "object",
              "additionalProperties": false,
              "description": "模型能力声明，字段名与 LiteLLM ModelInfo 的 supports_* 字段保持一致；supports_video_input 是本项目对视频输入的显式补充。",
              "properties": {
                "supports_vision": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否接受图片输入；对应 LiteLLM supports_vision。"
                  // 已验证：多模态输入路由使用该字段推导 image 能力。
                },
                "supports_video_input": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否接受视频输入；LiteLLM 当前没有统一 supports_video 字段，因此由本项目显式声明。"
                  // 已验证：视频 content block 校验使用该字段，不再读取旧 capabilities 数组。
                },
                "supports_audio_input": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否接受音频输入；对应 LiteLLM supports_audio_input。"
                  // 已验证：音频 content block 校验使用 LiteLLM 对齐字段。
                },
                "supports_audio_output": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否能输出音频；对应 LiteLLM supports_audio_output，当前只作为能力声明保存。"
                  // 已验证：配置解析保留该能力，当前请求适配不把它误当成输入能力。
                },
                "supports_function_calling": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否支持工具/函数调用；对应 LiteLLM supports_function_calling。"
                  // 已验证：模型能力路由可读取该字段。
                },
                "supports_reasoning": {
                  "type": "boolean",
                  "default": false,
                  "description": "模型是否支持 reasoning；必须与 supports_reasoning 下至少一个实际线格式字段一致。"
                  // 已验证：解析器会拒绝该字段与具体 reasoning 线格式不一致的配置。
                }
              }
            },
            "supports_reasoning": {
              "type": "object",
              "description": "按 protocol 声明模型返回和接收的 reasoning 字段；这里描述 wire format，不复制到 AIMessage.additional_kwargs。",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "reasoning_content": {
                      "type": "boolean",
                      "default": false,
                      "description": "Chat Completions 的 assistant.reasoning_content。"
                      // 已验证：Chat Completions adapter 用该字段投影历史 reasoning_content。
                    },
                    "thinking_blocks": {
                      "type": "boolean",
                      "default": false,
                      "description": "Chat Completions 兼容端返回 thinking_blocks。"
                      // 已验证：Chat Completions adapter 可从 payload 提取 thinking_blocks。
                    }
                  },
                  "anyOf": [
                    {"required": ["reasoning_content"]},
                    {"required": ["thinking_blocks"]}
                  ]
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "reasoning_items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["summary", "encrypted_content"],
                      "properties": {
                        "summary": {
                          "type": "boolean",
                          "description": "Responses reasoning item 的 summary。"
                          // 已验证：Responses 历史投影会保留 summary。
                        },
                        "encrypted_content": {
                          "type": "boolean",
                          "description": "Responses reasoning item 的 encrypted_content。"
                          // 已验证：只有 replay_policy.same_source 时才回放该字段。
                        }
                      }
                    }
                  },
                  "required": ["reasoning_items"]
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "thinking_blocks": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["thinking", "redacted_thinking"],
                      "properties": {
                        "thinking": {
                          "type": "boolean",
                          "description": "Anthropic Messages thinking block 的明文 thinking。"
                          // 已验证：Anthropic 配置解析会映射到 thinking_blocks_thinking。
                        },
                        "redacted_thinking": {
                          "type": "boolean",
                          "description": "Anthropic Messages thinking block 的 redacted_thinking。"
                          // 已验证：Anthropic 配置解析会映射到 thinking_blocks_redacted_thinking。
                        }
                      }
                    }
                  },
                  "required": ["thinking_blocks"]
                }
              ]
            },
            "request_features": {
              "type": "object",
              "additionalProperties": false,
              "description": "请求适配器可选附加的特性，不属于模型输入输出能力。",
              "properties": {
                "prompt_cache_key": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否向 Chat Completions 请求附加 prompt_cache_key。"
                  // 已验证：prompt cache key 路径读取该字段，不再读取旧 capabilities 数组。
                }
              }
            },
            "replay_policy": {
              "type": "object",
              "additionalProperties": false,
              "description": "历史 reasoning 回放规则；加密内容不能仅凭 custom_llm_provider 相同而回放。",
              "properties": {
                "encrypted_content": {
                  "type": "string",
                  "enum": ["same_source"],
                  "default": "same_source",
                  "description": "只允许同一稳定 provider 实例 ID 回放 Responses encrypted_content。"
                  // 已验证：密文来源比较使用 provider.id，而不是 custom_llm_provider。
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "protocol": {"const": "chat_completions"}
                }
              },
              "then": {
                "properties": {
                  "supports_reasoning": {
                    "additionalProperties": false,
                    "properties": {
                      "reasoning_content": {"type": "boolean"},
                      "thinking_blocks": {"type": "boolean"}
                    },
                    "anyOf": [
                      {"required": ["reasoning_content"]},
                      {"required": ["thinking_blocks"]}
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "protocol": {"const": "responses"}
                }
              },
              "then": {
                "properties": {
                  "supports_reasoning": {
                    "additionalProperties": false,
                    "properties": {
                      "reasoning_items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["summary", "encrypted_content"],
                        "properties": {
                          "summary": {"type": "boolean"},
                          "encrypted_content": {"type": "boolean"}
                        }
                      }
                    },
                    "required": ["reasoning_items"]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "protocol": {"const": "anthropic_messages"}
                }
              },
              "then": {
                "properties": {
                  "supports_reasoning": {
                    "additionalProperties": false,
                    "properties": {
                      "thinking_blocks": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["thinking", "redacted_thinking"],
                        "properties": {
                          "thinking": {"type": "boolean"},
                          "redacted_thinking": {"type": "boolean"}
                        }
                      }
                    },
                    "required": ["thinking_blocks"]
                  }
                }
              }
            }
          ]
        },
        "auth_header": {
          "type": "string",
          "minLength": 1
        },
        "request_options": {
          "type": "object",
          "description": "Provider-specific request options passed to the chat model client.",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "overrides": {
              "type": "object",
              "description": "Raw LiteLLM completion parameters. These values override agent-level defaults such as temperature, top_p and max_tokens. Put provider body extensions under extra_body.",
              "additionalProperties": true,
              "default": {}
            },
            "default_headers": {
              "type": "object",
              "description": "Additional default HTTP headers for this provider.",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            }
          }
        }
      }
    },

    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "instructions",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the agent",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "language": {
          "type": "string",
          "description": "Default response language",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "default": "zh-CN"
        },
        "timezone": {
          "type": "string",
          "description": "Default timezone, preferably IANA timezone name",
          "minLength": 1,
          "maxLength": 64,
          "default": "Asia/Shanghai"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "uniqueItems": true,
          "maxItems": 20,
          "default": []
        },
        "persona": {
          "$ref": "#/$defs/agentPersona"
        },
        "instructions": {
          "$ref": "#/$defs/agentInstructions"
        },
        "model": {
          "$ref": "#/$defs/agentModel"
        },
        "tools": {
          "$ref": "#/$defs/agentTools"
        },
        "knowledge": {
          "$ref": "#/$defs/agentKnowledge"
        },
        "memory": {
          "$ref": "#/$defs/agentMemory"
        },
        "safety": {
          "$ref": "#/$defs/agentSafety"
        },
        "execution": {
          "$ref": "#/$defs/agentExecution"
        },
        "env": {
          "$ref": "#/$defs/agentEnv"
        }
      }
    },

    "agentPersona": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "tone": {
          "type": "string",
          "enum": [
            "professional",
            "friendly",
            "concise",
            "formal",
            "technical"
          ],
          "default": "professional"
        },
        "identity": {
          "type": "string",
          "maxLength": 2000
        },
        "verbosity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        }
      }
    },

    "agentInstructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_prompt"
      ],
      "properties": {
        "system_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "developer_prompt": {
          "type": "string",
          "maxLength": 20000
        },
        "fallback_prompt": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },

    "agentModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_provider"
      ],
      "properties": {
        "primary_provider": {
          "type": "string",
          "description": "Primary provider ID from llm.providers[].id",
          "pattern": "^[a-zA-Z0-9._-]{2,64}$"
        },
        "fallback_providers": {
          "type": "array",
          "description": "Fallback provider IDs from llm.providers[].id, used in order",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{2,64}$"
          },
          "uniqueItems": true,
          "maxItems": 10,
          "default": []
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Optional explicit sampling temperature. Omit to use the provider/model default."
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Optional explicit nucleus sampling value. Omit to use the provider/model default."
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional explicit output cap. Omit to avoid imposing a client-side output limit."
        }
      }
    },
    "agentTools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "tool_choice": {
          "type": "string",
          "enum": [
            "none",
            "auto",
            "required"
          ],
          "default": "auto"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 10000
        },
        "allowlist": {
          "type": "array",
          "description": "恢复列表。工具全集为 U：先把 denylist 展开为禁用集合 D，再把 allowlist 展开为恢复集合 A；最终禁用 D-A，最终可用 U-(D-A)。默认所有工具可用。保留值 all 表示所有工具，extensions 表示所有扩展子工具。",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,63}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "denylist": {
          "type": "array",
          "description": "禁用列表。工具全集为 U：先把 denylist 展开为禁用集合 D，再把 allowlist 展开为恢复集合 A；最终禁用 D-A，最终可用 U-(D-A)。扩展子工具直接按其 name 禁用。保留值 all 表示所有工具，extensions 表示所有扩展子工具。",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,63}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "confirmation_required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,63}$"
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        },
        "custom": {
          "type": "array",
          "description": "内置工具使用稳定 tool_id；第三方扩展使用 name 与 factory。",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool_id"],
                "properties": {
                  "tool_id": {
                    "type": "string",
                    "enum": [
                      "read_context", "search_context", "web_search", "fetch_webpage",
                      "listBrowserPage", "openBrowserPage", "readPage", "navigatePage", "clickElement",
                      "typeInPage", "hoverElement", "dragElement", "handleDialog",
                      "screenshotPage", "runPlaywrightCode", "test_tool_2", "large_test_output"
                    ]
                  },
                  "options": {
                    "type": "object",
                    "description": "传给该工具 factory 的专属配置。",
                    "additionalProperties": true
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "工具目录中展示的扩展工具说明。"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "factory"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,63}$"
                  },
                  "factory": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_.]*$"
                  },
                  "options": {
                    "type": "object",
                    "description": "传给该工具 factory 的专属配置。",
                    "additionalProperties": true
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "工具目录中展示的扩展工具说明。"
                  }
                }
              }
            ]
          },
          "uniqueItems": true,
          "maxItems": 100,
          "default": []
        }
      }
    },
    "agentKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentKnowledgeSource"
          },
          "maxItems": 20,
          "default": []
        },
        "retrieval": {
          "$ref": "#/$defs/agentRetrieval"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "sources"
            ]
          }
        }
      ]
    },

    "agentKnowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{2,64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "web",
            "file",
            "directory",
            "notion",
            "s3",
            "custom"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "auth_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to secret or environment variable",
          "pattern": "^[A-Z0-9_./:-]+$"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },

    "agentRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "keyword",
            "vector",
            "hybrid"
          ],
          "default": "hybrid"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        },
        "score_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.65
        },
        "rerank": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "agentMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "session",
            "user",
            "workspace"
          ],
          "default": "workspace"
        },
        "backend": {
          "type": "string",
          "enum": [
            "redis",
            "postgres",
            "vector-db",
            "custom"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 315360000,
          "default": 2592000
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "default": 200
        },
        "store_user_preferences": {
          "type": "boolean",
          "default": true
        },
        "store_sensitive_data": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "backend"
            ]
          }
        }
      ]
    },

    "agentSafety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_mode": {
          "type": "string",
          "enum": [
            "off",
            "standard",
            "strict"
          ],
          "default": "standard"
        },
        "prompt_injection_protection": {
          "type": "boolean",
          "default": true
        },
        "pii_redaction": {
          "type": "boolean",
          "default": true
        },
        "refuse_secrets_exfiltration": {
          "type": "boolean",
          "default": true
        }
      }
    },

    "agentExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": "boolean",
          "default": true
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 16
        },
        "max_history_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "default": 30
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 200000,
          "default": 32000
        },
        "require_delegated_report": {
          "type": "boolean",
          "default": false,
          "description": "是否强制委派子 Agent 通过 send_message_to_session 向父会话报告结果"
        }
      }
    },

    "agentEnv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "default": "development"
        },
        "region": {
          "type": "string",
          "maxLength": 64,
          "default": ""
        },
        "feature_flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        }
      }
    }
  }
}
