{
  "$schema": "./workspace_schema.jsonc",
  "config_version": 1,
  "llm": {
    "providers": [
      {
        "id": "primary",
        "endpoint": "https://opencode.ai/zen/v1",
        "model": "big-pickle",
        "custom_llm_provider": "openai",
        "api_mode": {
          "protocol": "chat_completions",
          "model_info": {
            "supports_function_calling": true,
            "supports_reasoning": true
          },
          "supports_reasoning": {"reasoning_content": true}
        },
        "api_key": "${OPENCODE_ZEN_API_KEY}",
      },
      {
        "id": "backup_1",
        "endpoint": "https://api.kilo.ai/api/gateway",
        "model": "openrouter/free",
        "custom_llm_provider": "openai",
        "api_mode": {
          "protocol": "chat_completions",
          "model_info": {
            "supports_function_calling": true,
            "supports_reasoning": true
          },
          "supports_reasoning": {"reasoning_content": true}
        },
        "api_key": "${KILO_API_KEY}"
      },
      {
        "id": "backup_2",
        "endpoint": "https://openrouter.ai/api/v1",
        "model": "openrouter/free",
        "custom_llm_provider": "openrouter",
        "api_mode": {
          "protocol": "chat_completions",
          "model_info": {
            "supports_function_calling": true,
            "supports_reasoning": true
          },
          "supports_reasoning": {"reasoning_content": true}
        },
        "api_key": "${OPENROUTER_API_KEY}"
      },
      {
        "id": "backup_3",
        "endpoint": "https://www.cctq.ai/v1",
        "model": "gpt-5.6-luna",
        "custom_llm_provider": "openai",
        "api_mode": {
          "protocol": "responses",
          "model_info": {
            "supports_vision": true,
            "supports_function_calling": true,
            "supports_reasoning": true
          },
          "supports_reasoning": {
            "reasoning_items": {"summary": true, "encrypted_content": true}
          },
          "request_features": {"prompt_cache_key": true},
          "replay_policy": {"encrypted_content": "same_source"}
        },
        "api_key": "${CCTQ_API_KEY}",
        "request_options": {
          "overrides": {
            "reasoning": {
              "effort": "high",
              "summary": "auto"
            }
          }
        }
      },
      {
        "id": "backup_4",
        "endpoint": "https://chatgpt.com/backend-api/codex",
        "model": "gpt-5.6-luna",
        "custom_llm_provider": "chatgpt",
        "api_mode": {
          "protocol": "responses",
          "model_info": {
            "supports_vision": true,
            "supports_function_calling": true,
            "supports_reasoning": true
          },
          "supports_reasoning": {
            "reasoning_items": {"summary": true, "encrypted_content": true}
          },
          "replay_policy": {"encrypted_content": "same_source"}
        },
        "auth": {
          "type": "oauth",
          "method": "chatgpt"
        },
        "request_options": {
          "overrides": {
            "reasoning": {
              "effort": "high",
              "summary": "auto"
            }
          }
        }
      }
    ]
  },
  "logger": {
    "level": "info"
  },
  "default_agent": "default",
  "agents": {
    "default": {
      "name": "Workspace Assistant",
      "description": "工作区默认助手，负责通用问答、代码解释、开发辅助和文档问答。",
      "language": "zh-CN",
      "instructions": {
        "system_prompt": "你是面向工程团队的工作区助手。优先提供准确、可执行、可验证的回答；信息不足时明确指出缺失信息。"
      },
      "model": {
        "primary_provider": "primary",
        "fallback_providers": [
          "backup_1",
          "backup_2",
          "backup_3",
          "backup_4"
        ]
      },
      "tools": {
        "denylist": [],
        "confirmation_required": [],
        "custom": [
          {
            "tool_id": "test_tool_2"
          },
          {
            "tool_id": "read_context"
          },
          {
            "tool_id": "search_context"
          },
          {
            "tool_id": "web_search"
          },
          {
            "tool_id": "fetch_webpage",
            "options": {
              "embedding": {
                "provider_id": "backup_2",
                "model": "openai/text-embedding-3-small"
              }
            }
          },
          {
            "tool_id": "listBrowserPage"
          },
          {
            "tool_id": "openBrowserPage"
          },
          {
            "tool_id": "readPage"
          },
          {
            "tool_id": "navigatePage"
          },
          {
            "tool_id": "clickElement"
          },
          {
            "tool_id": "typeInPage"
          },
          {
            "tool_id": "hoverElement"
          },
          {
            "tool_id": "dragElement"
          },
          {
            "tool_id": "handleDialog"
          },
          {
            "tool_id": "screenshotPage"
          },
          {
            "tool_id": "runPlaywrightCode"
          },
          {
            "name": "list_debug_configurations",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "list_debug_configurations" },
            "description": "列出当前会话的可移植源码调试方案，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "create_debug_configuration",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "create_debug_configuration" },
            "description": "创建并激活目标程序调试方案，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "activate_debug_configuration",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "activate_debug_configuration" },
            "description": "激活当前会话的目标程序调试方案，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "delete_debug_configuration",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "delete_debug_configuration" },
            "description": "删除当前会话未运行的目标程序调试方案，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "start_debugging",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "start_debugging" },
            "description": "源码调试扩展工具 start_debugging，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "stop_debugging",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "stop_debugging" },
            "description": "源码调试扩展工具 stop_debugging，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "step_over",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "step_over" },
            "description": "源码调试扩展工具 step_over，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "step_into",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "step_into" },
            "description": "源码调试扩展工具 step_into，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "step_out",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "step_out" },
            "description": "源码调试扩展工具 step_out，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "continue_execution",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "continue_execution" },
            "description": "源码调试扩展工具 continue_execution，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "pause_execution",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "pause_execution" },
            "description": "源码调试扩展工具 pause_execution，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "restart_debugging",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "restart_debugging" },
            "description": "源码调试扩展工具 restart_debugging，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "add_breakpoint",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "add_breakpoint" },
            "description": "源码调试扩展工具 add_breakpoint，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "add_logpoint",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "add_logpoint" },
            "description": "源码调试扩展工具 add_logpoint，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "remove_breakpoint",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "remove_breakpoint" },
            "description": "源码调试扩展工具 remove_breakpoint，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "clear_all_breakpoints",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "clear_all_breakpoints" },
            "description": "源码调试扩展工具 clear_all_breakpoints，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "list_breakpoints",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "list_breakpoints" },
            "description": "源码调试扩展工具 list_breakpoints，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "list_variable_names",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "list_variable_names" },
            "description": "源码调试扩展工具 list_variable_names，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "get_variables_values",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "get_variables_values" },
            "description": "源码调试扩展工具 get_variables_values，必须通过 invoke_custom_tool 调用。"
          },
          {
            "name": "evaluate_expression",
            "factory": "app.agents.tools.debugging:create_debugging_tool",
            "options": { "tool_name": "evaluate_expression" },
            "description": "源码调试扩展工具 evaluate_expression，必须通过 invoke_custom_tool 调用。"
          }
        ]
      }
    },
    "coder": {
      "name": "Coding Assistant",
      "description": "专门用于代码实现、重构和修复问题。",
      "language": "zh-CN",
      "instructions": {
        "system_prompt": "你是工程实践导向的编程助手。输出代码时优先保证正确性、可读性和可验证性。"
      },
      "model": {
        "primary_provider": "primary",
        "fallback_providers": [
          "backup_1",
          "backup_2",
          "backup_3",
          "backup_4"
        ]
      },
      "tools": {
        "denylist": [
          "edit_file"
        ],
        "confirmation_required": []
      }
    },
    "reviewer": {
      "name": "Code Reviewer",
      "description": "专门用于代码审查、风险检查和设计评估。",
      "language": "zh-CN",
      "instructions": {
        "system_prompt": "你是代码审查助手。优先指出正确性、架构、安全性和可维护性问题，并给出具体依据。"
      },
      "model": {
        "primary_provider": "primary",
        "fallback_providers": [
          "backup_1",
          "backup_2",
          "backup_3",
          "backup_4"
        ]
      }
    },
    "researcher": {
      "name": "Research Assistant",
      "description": "专门用于资料检索、文档总结和方案调研。",
      "language": "zh-CN",
      "instructions": {
        "system_prompt": "你是调研助手。优先基于可验证来源归纳结论，并明确不确定点和假设。"
      },
      "model": {
        "primary_provider": "primary",
        "fallback_providers": [
          "backup_1",
          "backup_2",
          "backup_3",
          "backup_4"
        ]
      }
    }
  },
  "development": {
    "test_tools": true
  },
  "mcp": {
    "servers": {
      "tui-mcp": {
        "enabled": true,
        "transport": "stdio",
        "command": "npx",
        "args": [
          "--yes",
          "tui-mcp"
        ]
      }
    }
  }
}
