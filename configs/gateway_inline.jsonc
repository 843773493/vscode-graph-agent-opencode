// Gateway 配置节点：仅沿显式 extends 继承；工作区业务配置由各 Backend 自行读取。
{
  "$schema": "./gateway_schema.jsonc",
  "config_version": 6,
  "settings": {
    "network": {
      "proxy": {
        "mode": "environment"
      }
    },
    "gateway": {
      "plugins": {
        "sources": {
          "entries": []
        },
        "runtime": {
          "entries": []
        },
        "workspace_defaults": {
          "entries": [
            {
              "package_id": "boxteam.developer-tools",
              "package_version": "0.1.1",
              "plugin_id": "terminal",
              "enabled": true
            },
            {
              "package_id": "boxteam.developer-tools",
              "package_version": "0.1.1",
              "plugin_id": "browser",
              "enabled": true
            },
            {
              "package_id": "boxteam.developer-tools",
              "package_version": "0.1.1",
              "plugin_id": "debugging",
              "enabled": true
            }
          ]
        }
      },
      "logging": {
        "runtime": {
          "level": "info",
          "pretty": true
        },
        "retention": {}
      },
      "telemetry": {
        "runtime": {
          "enabled": false,
          "sample_ratio": 1,
          "sample_buffer_limit": 256
        }
      },
      "statistics": {
        "runtime": {
          "enabled": false,
          "collection_interval_ms": 5000
        }
      },
      "resources": {
        "skill_sources": {
          "sources": [],
          "local_updates": {
            "mode": "event",
            "poll_interval": null
          }
        }
      },
      "workspaces": [],
      "features": {
        "session_catalog": {
          "sync": {
            "refresh_interval_seconds": 30,
            "max_concurrency": 8,
            "request_timeout_seconds": 30
          }
        },
        "session_history": {
          "loading": {
            "progressive": {
              "initial": {
                "turns": 5,
                "include": [
                  "user",
                  "metadata",
                  "thinking",
                  "tool_summary",
                  "final_response",
                  "internal"
                ]
              },
              "anchor": {
                "before_turns": 3,
                "after_turns": 3,
                "include": [
                  "user",
                  "metadata",
                  "final_response",
                  "internal"
                ]
              }
            }
          }
        }
      },
      "runtime": {
        "gateway": {
          "process": {
            "health": {
              "request_timeout_seconds": 2,
              "poll_interval_seconds": 0.5
            },
            "lifecycle": {
              "connection_drain_timeout_seconds": 2
            }
          }
        },
        "workspace": {
          "default_skill_groups": [
            "gateway-context",
            "web-search-fetch"
          ]
        }
      }
    }
  }
}
