{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoxTeam user profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "display_name",
    "layout",
    "preferences"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "config_version": {"const": 2},
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "layout": {"type": "object", "additionalProperties": true},
    "preferences": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
