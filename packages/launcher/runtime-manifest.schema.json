{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxteam.dev/schemas/runtime-manifest-v1.json",
  "title": "BoxTeam Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "distribution",
    "version",
    "python_executable",
    "application_root",
    "config_resources",
    "skill_resources",
    "bundled_plugins",
    "node"
  ],
  "properties": {
    "bundled_plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "package_version"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "minLength": 1
          },
          "package_version": {
            "type": "string",
            "minLength": 1
          },
          "archive": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "directory"
            ],
            "not": {
              "required": [
                "archive"
              ]
            }
          },
          {
            "required": [
              "archive"
            ],
            "not": {
              "required": [
                "directory"
              ]
            }
          }
        ]
      }
    },
    "schema_version": {
      "const": 1
    },
    "distribution": {
      "enum": [
        "source-development",
        "source-installed",
        "npm",
        "standalone"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "python_executable": {
      "type": "string",
      "minLength": 1
    },
    "application_root": {
      "type": "string",
      "minLength": 1
    },
    "config_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_inline",
        "gateway_schema",
        "workspace_inline",
        "workspace_schema"
      ],
      "properties": {
        "gateway_inline": {
          "type": "string",
          "minLength": 1
        },
        "gateway_schema": {
          "type": "string",
          "minLength": 1
        },
        "workspace_inline": {
          "type": "string",
          "minLength": 1
        },
        "workspace_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skill_resources": {
      "type": "string",
      "minLength": 1
    },
    "web_assets": {
      "type": [
        "string",
        "null"
      ]
    },
    "chromium_executable": {
      "type": [
        "string",
        "null"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "launcher",
            "bundled"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "desktop_executable": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "可选的 Electron 桌面入口，相对 runtime manifest 所在目录解析；由 Launcher 在 Gateway 就绪后启动。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution": {
            "enum": [
              "npm",
              "standalone"
            ]
          }
        },
        "required": [
          "distribution"
        ]
      },
      "then": {
        "properties": {
          "node": {
            "type": "object",
            "properties": {
              "source": {
                "const": "bundled"
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  ]
}
