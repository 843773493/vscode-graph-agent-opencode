# 复制到 tools/ssh/windows-vm-remote.env，并填入本机专用值。
WINDOWS_VM_REMOTE_HOST=root@example.internal
WINDOWS_VM_REMOTE_PORT=22
WINDOWS_VM_REMOTE_ROOT=/srv/boxteam-windows-vm
WINDOWS_VM_REMOTE_REPO=/srv/boxteam-windows-vm/repository
