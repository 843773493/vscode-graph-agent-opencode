{
  "name": "@boxteam/plugin-sdk",
  "version": "0.0.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "default": "./dist/commands.js"
    },
    "./logging": {
      "types": "./src/logging.ts",
      "default": "./dist/logging.js"
    },
    "./observation": {
      "types": "./src/observation.ts",
      "default": "./dist/observation.js"
    },
    "./process-lifecycle": {
      "types": "./src/process-lifecycle.ts",
      "default": "./dist/process-lifecycle.js"
    },
    "./control": {
      "types": "./src/control.ts",
      "default": "./dist/control.js"
    },
    "./http": {
      "types": "./src/http.ts",
      "default": "./dist/http.js"
    },
    "./maintenance": {
      "types": "./src/maintenance.ts",
      "default": "./dist/maintenance.js"
    },
    "./generated/boxteam/*": "./dist/generated/boxteam/*",
    "./generated-json/boxteam/*.js": {
      "types": "./src/generated-json/boxteam/*.ts",
      "default": "./dist/generated-json/boxteam/*.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "esbuild": "^0.28.2"
  }
}
