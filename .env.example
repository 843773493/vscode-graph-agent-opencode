# `bun run dev` 会在启动服务前将本文件对应的 `.env` 复制到
# `${BOXTEAM_HOME:-<当前仓库>/out/development-runtime/boxteam-home}/config/.env`；运行时只读取安装后的文件。

# 源码开发实例隔离：不同 worktree 请使用不同的端口偏移量。
# 当前默认开发实例使用 16；其他 worktree 可使用 100、200 等。
# scripts/launch/dev.mjs 会据此计算后端、前端、Gateway 和辅助服务端口。
BOXTEAM_DEV_PORT_OFFSET=16

SILICONFLOW_API_KEY=your-api-key-here
OPENROUTER_API_KEY=
GEMINI_API_KEY=your-api-key-here
CCTQ_API_KEY=
GITHUB_TOKEN=your-github-token-here
OPENCODE_ZEN_API_KEY=
KILO_API_KEY=
GH_TOKEN=

# 设为 1 时安装 Gateway E2E SSH 资产，并在用户级配置中启用开发测试工具。
BOXTEAM_INSTALL_DEVELOPMENT_ASSETS=0
# 设为 1 时把正在运行的 Gateway E2E SSH 容器注册为工作区；依赖上面的开发资产开关。
BOXTEAM_ENABLE_GATEWAY_E2E_WORKSPACE=0

# 可选：当前网络无法直连模型 Provider 时配置；留空即不使用代理。
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,100.64.0.129,10.31.5.12

# 开发服务的基准端口由 scripts/launch/dev-environment.mjs 定义；偏移 16 后，
# 工作区后端为 8026、Web 前端为 8027、Gateway 为 8030，终端、浏览器和调试端口也统一偏移。
# 安装/部署版使用固定端口（Gateway 为 8014），不读取源码开发端口偏移。
# 默认用户工作区留空时使用 ~/.boxteams/boxteam_workspace。
BOXTEAM_DEFAULT_USER_WORKSPACE_ROOT=
# BoxTeam 用户级安装和全局状态根目录。源码开发如需覆盖目标目录，必须在
# 执行 `bun run dev` 前通过 Shell 设置；不能由本文件反向决定自身安装位置。
BOXTEAM_HOME=
# 源码开发留空时使用当前 worktree 的 out/development-runtime/boxteam-home；安装版仍使用 ~/.boxteams。
# Gateway 与 Workspace 用户配置分别写入 BOXTEAM_HOME/config/gateway.jsonc
# 和 BOXTEAM_HOME/config/workspace.jsonc；测试通过独立 BOXTEAM_HOME 隔离。
# Web UI 偏好设置写入 BOXTEAM_HOME/state/gateway/users/<user_id>/profile.jsonc。
# SSH 远端后端端口使用远端自己的端口，例如容器内仍可用 8010。
# Gateway 会在宿主机此范围内选择随机本地端口来建立 SSH 隧道。
BOXTEAM_GATEWAY_SSH_TUNNEL_PORT_MIN=41000
BOXTEAM_GATEWAY_SSH_TUNNEL_PORT_MAX=41999
BOXTEAM_BROWSER_BACKEND_URL=http://127.0.0.1:8015
BOXTEAM_BROWSER_FRONTEND_URL=http://127.0.0.1:8016
BOXTEAM_BROWSER_WORKSPACE_ROOT=
# 仅用于 Docker/SSH gateway e2e；普通运行不需要设置。
BOXTEAM_RUN_DOCKER_GATEWAY_E2E=0
BOXTEAM_DOCKER_COMMAND=docker
BOXTEAM_GATEWAY_E2E_SSH_USER=root

# LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
