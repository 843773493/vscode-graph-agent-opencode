{
  "name": "vscode-graph-agent",
  "displayName": "BoxTeam",
  "description": "A local workspace-aware AI coding assistant with a FastAPI backend and Web client.",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "worktree": "bun scripts/launch/worktree.mjs",
    "workspace": "bun scripts/launch/workspace.mjs",
    "release:policy": "bun scripts/release/policy.mjs",
    "dev:backend": "bun run scripts/launch/dev.mjs --service=backend",
    "dev:gateway": "bun run scripts/launch/dev.mjs --service=gateway",
    "test:matrix": "bun tests/runner/run-tests.mjs",
    "plugin:pack:mcp-stdio": "bun scripts/plugins/pack-mcp-stdio.mjs",
    "test:integration:web:anchored-overlay": "bun tests/integration/clients/web/components/anchored_overlay_positioning.mjs",
    "dev": "bun run scripts/launch/workspace.mjs dev start",
    "dev:root": "bun run scripts/launch/workspace.mjs root start",
    "dev:foreground": "bun run scripts/launch/dev.mjs --service=all",
    "dev:stop": "bun run scripts/launch/workspace.mjs dev stop",
    "dev:status": "bun run scripts/launch/workspace.mjs dev status",
    "dev:web": "bun run scripts/launch/dev.mjs --service=web",
    "build:web": "bun run --cwd=src/clients/workbench build",
    "install:config": "uv run python -m configs.boxteam --project-root .",
    "check:protocol": "bun run ./scripts/generate_protocol.mjs --check",
    "check:protocol:breaking": "bun run ./scripts/generate_protocol.mjs --check --breaking-against",
    "gen:protocol": "bun run ./scripts/generate_protocol.mjs",
    "package:linux-x64": "bun run scripts/release/package-linux-x64.mjs",
    "package:windows-x64": "bun run scripts/release/package-windows-x64.mjs",
    "package:windows-x64-cross": "bun run scripts/release/package-windows-x64-cross.mjs",
    "gen:openapi": "uv run python -m scripts.export_openapi_snapshot",
    "dev:electron": "bun run --cwd src/clients/electron start",
    "build:electron": "bun run --cwd src/clients/electron build",
    "package:electron": "bun scripts/release/package-electron.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protobuf": "^2.14.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@electron-internal/extract-zip": "1.0.8",
    "@electron/get": "^5.1.0",
    "@electron/packager": "^20.3.0",
    "@lickle/lock": "0.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "^8.20.0",
    "cross-spawn": "7.0.6",
    "esbuild": "^0.28.2",
    "http-proxy": "^1.18.1",
    "json-schema-to-typescript": "^15.0.4",
    "jsonc-parser": "^3.3.1",
    "mocha": "^11.7.1",
    "node-gyp": "10.3.1",
    "node-pty": "^1.1.0",
    "open": "11.0.4",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "shlex": "1.0.3",
    "tar": "7.5.22",
    "ws": "^8.18.0",
    "yazl": "3.3.1"
  }
}
