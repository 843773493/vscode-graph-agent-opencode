{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "typeRoots": ["../../../../src/web/node_modules/@types"],
    "baseUrl": "../../../../",
    "paths": {
      "react": ["src/web/node_modules/@types/react/index.d.ts"],
      "react/*": ["src/web/node_modules/@types/react/*"],
      "react-dom": ["src/web/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["src/web/node_modules/@types/react-dom/*"],
      "@floating-ui/react": ["src/web/node_modules/@floating-ui/react"]
    }
  },
  "include": ["anchored_overlay_positioning_harness.tsx"]
}
