      "react-dom": ["src/clients/web/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["src/clients/web/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["structured_user_message_attachments_harness.tsx"]
}
