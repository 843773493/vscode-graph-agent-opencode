{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "typeRoots": ["../../../../src/clients/web/node_modules/@types"],
    "baseUrl": "../../../../",
    "paths": {
      "react": ["src/clients/web/node_modules/@types/react/index.d.ts"],
