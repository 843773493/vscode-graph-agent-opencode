{
  // 客户端 E2E 当前只实现纯 Web。其他客户端保留 disabled TODO，不能被报告为通过。
  // 每个已启用 suite 默认带数据段内存上限与硬超时，防止无界增长的用例吃满整机内存。
  "schemaVersion": 1,
  "suites": [
    {
      "id": "integration-attachment-directory-install",
      "layer": "integration",
      "client": null,
      "enabled": true,
      "timeoutMs": 120000,
      "dataLimitKb": 4194304,
      "command": [
        "uv",
        "run",
        "--no-sync",
        "pytest",
        "-q",
        "tests/integration/backend/sessions/test_attachment_offline_install.py"
      ]
    },
    {
      "id": "unit-python",
      "layer": "unit",
      "client": null,
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/unit"]
    },
    {
      "id": "unit-web",
      "layer": "unit",
      "client": "web",
      "enabled": true,
      "command": ["bun", "test", "src/clients/web/src"]
    },
    {
      "id": "unit-workspace-services",
      "layer": "unit",
      "client": null,
      "enabled": true,
      "timeoutMs": 60000,
      "dataLimitKb": 4194304,
      "command": ["bun", "tests/runner/run-workspace-services.mjs"]
    },
    {
      "id": "contracts-python",
      "layer": "contracts",
      "client": null,
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/contracts"]
    },
    {
      "id": "integration-python",
      "layer": "integration",
      "client": null,
