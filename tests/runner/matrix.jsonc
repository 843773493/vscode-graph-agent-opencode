{
  // 客户端 E2E 当前只实现纯 Web。其他客户端保留 disabled TODO，不能被报告为通过。
  // 每个已启用 suite 默认带数据段内存上限与硬超时，防止无界增长的用例吃满整机内存。
  "schemaVersion": 1,
  "suites": [
    {
      "id": "unit-python",
      "layer": "unit",
      "client": null,
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/unit"]
    },
    {
      "id": "unit-web",
      "layer": "unit",
      "client": "web",
      "enabled": true,
      "command": ["bun", "test", "src/clients/web/src"]
    },
    {
      "id": "unit-workspace-services",
      "layer": "unit",
      "client": null,
      "enabled": true,
      "timeoutMs": 60000,
      "dataLimitKb": 4194304,
      "command": ["bun", "tests/runner/run-workspace-services.mjs"]
    },
    {
      "id": "contracts-python",
      "layer": "contracts",
      "client": null,
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/contracts"]
    },
    {
      "id": "integration-python",
      "layer": "integration",
      "client": null,
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/integration"]
    },
    {
      "id": "integration-execution-history-delta",
      "layer": "integration",
      "client": null,
      "enabled": true,
      "timeoutMs": 240000,
      "dataLimitKb": 4194304,
      "command": [
        "uv", "run", "--no-sync", "pytest", "-q",
        "tests/integration/backend/sessions/rollout_context/test_delta_fork_history.py",
        "tests/integration/backend/sessions/rollout_context/test_messages_delta_history.py",
        "tests/integration/backend/sessions/rollout_context/test_message_revisions.py",
        "tests/integration/backend/sessions/rollout_context/test_langgraph_channel_contract.py",
        "tests/integration/backend/sessions/rollout_context/test_rollout_checkpoint_saver.py",
        "tests/integration/backend/sessions/test_rollout_fork_protected.py",
        "tests/integration/backend/sessions/test_rollout_fork_plan_registry.py"
      ]
    },
    {
      "id": "integration-browser-element-references",
      "layer": "integration",
      "client": null,
      "enabled": true,
      "timeoutMs": 60000,
      "dataLimitKb": 4194304,
      "command": ["bun", "tests/integration/workspace_services/browser/browser_element_references.mjs"]
    },
    {
      "id": "integration-browser-checkpoint-form-state",
      "layer": "integration",
      "client": null,
      "enabled": true,
      "timeoutMs": 60000,
      "dataLimitKb": 4194304,
      "command": ["bun", "tests/integration/workspace_services/browser/browser_checkpoint_form_state.mjs"]
    },
    {
      "id": "integration-web-anchored-overlay",
      "layer": "integration",
      "client": "web",
      "enabled": true,
      "command": ["bun", "tests/integration/clients/web/components/anchored_overlay_positioning.mjs"]
    },
    {
      "id": "integration-web-session-catalog-outbox-idb",
      "layer": "integration",
      "client": "web",
      "enabled": true,
      "timeoutMs": 180000,
      "dataLimitKb": 4194304,
      "command": ["bun", "tests/integration/clients/web/session_catalog_outbox_idb.mjs"]
    },
    {
      "id": "e2e-web",
      "layer": "e2e",
      "client": "web",
      "enabled": true,
      "command": ["uv", "run", "pytest", "tests/e2e/clients/web"]
    },
    {
      "id": "e2e-web-basic-chat-tool-loop",
      "layer": "e2e",
      "client": "web",
      "enabled": true,
      "dataLimitKb": 4194304,
      "command": [
        "uv", "run", "pytest",
        "tests/e2e/clients/web/test_basic_chat_tool_loop.py::test_basic_chat_tool_loop_through_real_web_surface"
      ]
    },
    {
      "id": "e2e-electron",
      "layer": "e2e",
      "client": "electron",
      "enabled": false,
      "todo": "等待 Electron 客户端独立 OpenSpec"
    },
    {
      "id": "e2e-mobile-native",
      "layer": "e2e",
      "client": "mobile",
      "enabled": false,
      "todo": "等待 React Native 原生客户端 OpenSpec"
    }
  ]
}
